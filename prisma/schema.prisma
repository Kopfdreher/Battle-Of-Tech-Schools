generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Listing {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  address      String
  rentAmount   Decimal       @map("rent_amount") @db.Decimal(10, 2)
  rooms        Int
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  applications Application[]

  @@map("listings")
}

model Application {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  apartmentId           String?  @map("_apartment_id") @db.Uuid
  displayName           String   @map("display_name")
  email                 String?
  netIncomeMonthly      Decimal  @map("net_income_monthly") @db.Decimal(10, 2)
  contractType          String?  @map("contract_type")
  employmentType        String?  @map("employment_type")
  householdSize         Int      @map("household_size")
  hasArrearsLetter      Boolean  @map("has_arrears_letter")
  hasIncomeProof        Boolean? @map("has_income_proof")
  hasEmploymentProof    Boolean? @map("has_employment_proof")
  hasSchufa             Boolean  @map("has_schufa")
  smokes                Boolean?
  messagePreview        String   @map("message_preview")
  score                 Decimal? @db.Decimal(5, 2)
  riskFlags             Json     @default("[]") @map("risk_flags")
  status                String   @default("pending")
  source                String?  @map("_source")
  fingerprint           String?
  appliedAt             DateTime? @map("applied_at") @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  listing               Listing?  @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@index([apartmentId])
  @@map("applications")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
